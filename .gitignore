# Build do Jupyter Book
_build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Ambiente
ambiente/.env

# Dados baixados (datasets reais ficam fora do git; ver datasets/README.md)
datasets/data/
*.parquet
*.csv
!datasets/**/exemplo*.csv

# Plataforma Next.js (web/)
web/node_modules/
web/.next/
web/out/
web/src/content/           # conteúdo sincronizado (gerado no build via sync)
web/src/data/curso.json    # índice do curso (gerado no build via sync)
# O JupyterLite (web/public/lite) é COMMITADO para o deploy na Vercel funcionar
# (a Vercel não roda o Jupyter Book). Só ignoramos os source maps, que não são
# necessários em produção e pesam ~48 MB.
web/public/lite/**/*.map

# SO
.DS_Store
Thumbs.db
