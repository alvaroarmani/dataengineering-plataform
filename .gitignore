# Build do Jupyter Book
_build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Ambiente
ambiente/.env

# Dados baixados (datasets reais ficam fora do git; ver datasets/README.md)
datasets/data/
*.parquet
*.csv
!datasets/**/exemplo*.csv

# Plataforma Next.js (web/) — NÃO usar comentário inline (quebra o padrão!)
web/node_modules/
web/.next/
web/out/
web/.env*.local
# Conteúdo sincronizado + índice do curso: VERSIONADOS para o deploy (Vercel) funcionar
# sem acesso a ../modulos. Regenerados localmente pelo sync; commite após mudanças.
# (por isso NÃO são ignorados)
# JupyterLite: COMMITADO (sem .map) para o deploy na Vercel funcionar
# (a Vercel não roda o Jupyter Book). Os source maps (~48 MB) ficam de fora.
web/public/lite/**/*.map

# SO
.DS_Store
Thumbs.db

# Artefatos do dbt (gerados ao rodar na bancada)
target/
dbt_packages/
logs/
.user.yml
