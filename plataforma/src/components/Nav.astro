---
const { active = '' } = Astro.props;
---
<nav class="nav">
  <div style="display:flex;align-items:center;gap:32px">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:var(--ink)">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2.2"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="12" r="3"/><path d="M8.5 7.5 15 11M8.5 16.5 15 13"/></svg>
      <span style="font-family:var(--sora);font-weight:700;font-size:17px">Eng. de Dados</span>
    </a>
    <div class="nav-links">
      <a href="/" class={active === 'home' ? 'active' : ''}>Início</a>
      <a href="/trilha" class={active === 'trilha' ? 'active' : ''}>Trilha</a>
      <a href="/painel" class={active === 'painel' ? 'active' : ''}>Painel</a>
      <a href="/diario" class={active === 'diario' ? 'active' : ''}>Diário</a>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:14px">
    <span class="pill"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><path d="M12 3c1 3 4 4 4 8a4 4 0 1 1-8 0c0-2 1-3 2-4"/></svg>3 dias</span>
    <button class="icon-btn" onclick="alternarTema()" aria-label="Alternar tema">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <div class="avatar">A</div>
  </div>
</nav>
