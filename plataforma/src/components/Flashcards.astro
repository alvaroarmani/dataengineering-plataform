---
// Widget de estudo: um cartão por vez, clica e vira, navega com anterior/próximo.
const { cards = [] } = Astro.props;
---
<div class="fc" data-total={cards.length}>
  <div class="fc-top">
    <span class="fc-count">Cartão <b class="fc-i">1</b> de {cards.length}</span>
    <div class="fc-bar"><span class="fc-fill"></span></div>
  </div>

  <div class="fc-card" role="button" tabindex="0" aria-label="Clique para virar o cartão">
    <div class="fc-inner">
      <div class="fc-face fc-front">
        <span class="fc-tag">Pergunta</span>
        <p class="fc-text fc-p"></p>
        <span class="fc-hint">clique para revelar ↻</span>
      </div>
      <div class="fc-face fc-back">
        <span class="fc-tag fc-tag-r">Resposta</span>
        <p class="fc-text fc-r"></p>
      </div>
    </div>
  </div>

  <div class="fc-nav">
    <button class="btn btn-s fc-prev" type="button">← Anterior</button>
    <button class="btn btn-s fc-flip" type="button">Virar ↻</button>
    <button class="btn btn-p fc-next" type="button">Próximo →</button>
  </div>

  <script type="application/json" class="fc-data" set:html={JSON.stringify(cards)} />
</div>

<script>
  document.querySelectorAll('.fc').forEach((el) => {
    const cards = JSON.parse(el.querySelector('.fc-data').textContent || '[]');
    if (!cards.length) return;
    const card = el.querySelector('.fc-card');
    const pEl = el.querySelector('.fc-p');
    const rEl = el.querySelector('.fc-r');
    const iEl = el.querySelector('.fc-i');
    const fill = el.querySelector('.fc-fill');
    let i = 0;

    function mostrar() {
      card.classList.remove('flipped');
      pEl.textContent = cards[i].p;
      rEl.textContent = cards[i].r;
      iEl.textContent = String(i + 1);
      fill.style.width = ((i + 1) / cards.length) * 100 + '%';
    }
    function virar() { card.classList.toggle('flipped'); }
    function ir(d) { i = (i + d + cards.length) % cards.length; mostrar(); }

    card.addEventListener('click', virar);
    card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); virar(); } });
    el.querySelector('.fc-flip').addEventListener('click', virar);
    el.querySelector('.fc-next').addEventListener('click', () => ir(1));
    el.querySelector('.fc-prev').addEventListener('click', () => ir(-1));
    mostrar();
  });
</script>
