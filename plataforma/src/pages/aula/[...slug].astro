---
import Base from '../../layouts/Base.astro';
import curso from '../../data/curso.json';
import { getEntry } from 'astro:content';
import Flashcards from '../../components/Flashcards.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const eixo of curso.eixos) {
    for (const mod of eixo.modulos) {
      const seq = mod.unidades.filter((u) => u.tipo !== 'index');
      seq.forEach((u, i) => {
        paths.push({
          params: { slug: `${mod.pasta}/${u.base}` },
          props: { mod, eixo, unidade: u, prev: seq[i - 1] || null, next: seq[i + 1] || null, pos: i + 1, total: seq.length },
        });
      });
    }
  }
  return paths;
}

const { mod, eixo, unidade, prev, next, pos, total } = Astro.props;
const rotulo = { teoria: 'Teoria', lab: 'Lab', exercicio: 'Exercício', flashcards: 'Flashcards', recursos: 'Recursos' };

let Content = null;
let cards = [];
if (!unidade.isLab) {
  const entry = await getEntry('aulas', `${mod.pasta}/${unidade.base}`);
  if (entry) {
    if (unidade.tipo === 'flashcards') {
      const re = /^-\s*\*\*P:\*\*\s*(.+?)\s*\/\s*\*\*R:\*\*\s*(.+)$/gm;
      let m;
      while ((m = re.exec(entry.body || '')) !== null) cards.push({ p: m[1].trim(), r: m[2].trim() });
    } else {
      Content = (await entry.render()).Content;
    }
  }
}
const ehFlash = unidade.tipo === 'flashcards' && cards.length > 0;
const pct = Math.round((pos / total) * 100);
---
<Base title={unidade.titulo} active="home">
  <div class="lesson">
    <!-- Top -->
    <div class="lesson-top">
      <div style="display:flex;align-items:center;gap:12px;min-width:0">
        <a href={`/modulo/${mod.pasta}`} class="icon-btn" style="width:34px;height:34px" aria-label="Voltar ao módulo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
        </a>
        <div class="muted" style="font-size:13px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Eixo {eixo.id} · {mod.id} <span style="opacity:.5">/</span> <span style="color:var(--ink);font-weight:600">{rotulo[unidade.tipo] || unidade.tipo}</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:9px;width:170px">
        <div class="bar" style="flex-grow:1;background:var(--border)"><span style={`width:${pct}%`}></span></div>
        <span class="muted" style="font-size:12px;font-weight:600">{pos}/{total}</span>
      </div>
    </div>

    <!-- Body -->
    {unidade.isLab ? (
      <div class="lab-wrap">
        <div class="nb-toolbar">
          <div style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600" class="muted">
            <span style="width:9px;height:9px;border-radius:999px;background:var(--green)"></span> JupyterLite · Python (Pyodide)
          </div>
          <span class="muted" style="font-size:12px">roda no seu navegador</span>
        </div>
        <iframe class="nb-frame" title="Notebook interativo (JupyterLite)" src={unidade.href} loading="lazy"></iframe>
      </div>
    ) : ehFlash ? (
      <div class="lesson-body">
        <div class="prosa" style="max-width:680px">
          <h1>🃏 Flashcards — {mod.nome}</h1>
          <p class="muted">Tente responder de memória antes de virar. Revise sempre que voltar — é assim que fixa.</p>
        </div>
        <Flashcards cards={cards} />
      </div>
    ) : (
      <div class="lesson-body">
        <article class="prosa">
          <Content />
        </article>
      </div>
    )}

    <!-- Bottom nav -->
    <div class="lesson-bottom">
      {prev ? (
        <a class="btn btn-s" href={`/aula/${mod.pasta}/${prev.base}`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg><span class="hide-sm">{prev.titulo}</span><span class="only-sm">Anterior</span></a>
      ) : (
        <a class="btn btn-s" href={`/modulo/${mod.pasta}`}>Voltar ao módulo</a>
      )}
      {next ? (
        <a class="btn btn-p" href={`/aula/${mod.pasta}/${next.base}`}><span class="hide-sm">Próxima: {next.titulo}</span><span class="only-sm">Próxima</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></a>
      ) : (
        <a class="btn btn-p" href={`/modulo/${mod.pasta}`}>Concluir módulo</a>
      )}
    </div>
  </div>

  <script>
    import mermaid from 'mermaid';
    const nodes = document.querySelectorAll('pre.mermaid');
    if (nodes.length) {
      const root = document.documentElement;
      const dark = root.getAttribute('data-theme') === 'dark' ||
        (!root.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
      mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default', securityLevel: 'loose', fontFamily: 'Manrope, system-ui, sans-serif' });
      mermaid.run({ nodes });
    }
  </script>

  <style>
    .lesson{display:flex;flex-direction:column;min-height:calc(100vh - 73px)}
    .lesson-top{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border-bottom:1px solid var(--border);gap:12px}
    .lesson-body{flex:1;overflow:auto;padding:32px 24px}
    .lesson-body .prosa{max-width:760px;margin:0 auto}
    .lesson-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 20px;border-top:1px solid var(--border);background:var(--card)}
    .lesson-bottom .btn{max-width:48%;overflow:hidden}
    .lab-wrap{flex:1;display:flex;flex-direction:column;min-height:0;background:var(--card)}
    .nb-toolbar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border)}
    .nb-frame{flex:1;width:100%;border:0;background:#fff;min-height:70vh}
    .only-sm{display:none}
    @media (max-width:860px){ .hide-sm{display:none} .only-sm{display:inline} }
  </style>
</Base>
