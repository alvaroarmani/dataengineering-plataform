---
import Base from '../layouts/Base.astro';

const eixos = [
  { n: 'Eixo 1 — Fundamentos', pct: 12, on: true },
  { n: 'Eixo 2 — Data Warehousing', pct: 0, on: false },
  { n: 'Eixo 3 — Pipelines', pct: 0, on: false },
  { n: 'Eixo 4 — Escala & Governança', pct: 0, on: false },
];
---
<Base title="Seu painel — Engenharia de Dados" active="painel">
  <main class="wrap" style="padding-top:32px;padding-bottom:48px">

    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:22px">
      <h1 style="font-size:28px">Seu painel</h1>
      <span class="muted" id="hoje" style="font-size:14px"></span>
    </div>

    <!-- Stats -->
    <div class="grid" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:22px">
      <div class="card" style="padding:20px;text-align:center">
        <div style="display:flex;justify-content:center;margin-bottom:6px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><path d="M12 3c1 3.5 4.5 4.5 4.5 8.5a4.5 4.5 0 1 1-9 0c0-2 1-3.5 2.5-4.5"/></svg></div>
        <div id="stat-streak" style="font-family:var(--sora);font-weight:700;font-size:30px;color:var(--gold)">—</div><div class="lbl">dias de streak</div>
      </div>
      <div class="card" style="padding:20px;text-align:center"><div id="stat-pct" style="font-family:var(--sora);font-weight:700;font-size:30px;color:var(--green-d)">6%</div><div class="lbl">progresso total</div></div>
      <div class="card" style="padding:20px;text-align:center"><div id="stat-north" style="font-family:var(--sora);font-weight:700;font-size:30px;color:var(--green-d)">15</div><div class="lbl">p/ estar pronto p/ vagas</div></div>
      <div class="card" style="padding:20px;text-align:center"><div style="font-family:var(--sora);font-weight:700;font-size:30px;color:var(--green-d)">1</div><div class="lbl">projeto no GitHub</div></div>
    </div>

    <div class="grid" style="grid-template-columns:1.6fr 1fr">
      <!-- Left -->
      <div class="grid" style="gap:20px">
        <div class="card" style="padding:20px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><h3 style="font-size:17px">Mapa do curso</h3><span class="muted" style="font-size:13px">1 / 16 módulos</span></div>
          <div class="grid" style="gap:14px">
            {eixos.map((e) => (
              <div>
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px"><span style={`font-weight:600${e.on ? '' : ';color:var(--muted)'}`}>{e.n}</span><span class="muted">{e.pct}%</span></div>
                <div class="bar" style="background:var(--border)"><span style={`width:${e.pct}%`}></span></div>
              </div>
            ))}
          </div>
        </div>

        <div class="card" style="padding:20px">
          <h3 style="font-size:17px;margin-bottom:12px">Conquistas</h3>
          <div style="display:flex;flex-wrap:wrap;gap:10px">
            <span class="pill" style="background:var(--gold-bg);color:var(--gold)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15a5 5 0 0 0 5-5V4H7v6a5 5 0 0 0 5 5zM8 20h8M12 15v5"/></svg>1º módulo</span>
            <span class="pill" style="background:var(--gold-bg);color:var(--gold)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Testes verdes</span>
            <span class="pill" style="background:var(--green-t);color:var(--muted)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3c1 3.5 4.5 4.5 4.5 8.5a4.5 4.5 0 1 1-9 0"/></svg>7 dias seguidos</span>
            <span class="pill" style="background:var(--green-t);color:var(--muted)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h11l4 4v12H4z"/></svg>Eixo 1 completo</span>
          </div>
        </div>
      </div>

      <!-- Right -->
      <div class="grid" style="gap:20px">
        <div class="card" style="padding:20px;background:var(--green);border-color:var(--green);color:#fff">
          <div class="lbl" style="color:rgba(255,255,255,.8)">Revisar hoje</div>
          <div style="font-family:var(--sora);font-weight:600;font-size:18px;margin:8px 0 4px">5 flashcards · Módulo 1</div>
          <p style="font-size:13px;color:rgba(255,255,255,.85);margin:0 0 14px">Modo 5-min: mantém seu streak sem esforço.</p>
          <a href="/aula" style="display:block;text-align:center;background:#fff;color:var(--green-d);border-radius:9px;padding:11px 16px;font-weight:700;font-family:var(--man);min-height:44px">Revisar agora</a>
        </div>
        <div class="card" style="padding:20px">
          <div class="lbl">Desafio da semana</div>
          <p style="font-size:14px;margin:10px 0 0">SQL: escreva uma query com <em>window function</em> que traga o top-3 por categoria.</p>
        </div>
        <div class="card" style="padding:20px">
          <div class="lbl">Continue</div>
          <div style="font-weight:600;font-size:15px;margin:8px 0 10px">Lab 01 — Primeiro contato com dados</div>
          <div class="bar" style="background:var(--border)"><span style="width:35%"></span></div>
          <a class="btn btn-s" href="/aula" style="width:100%;justify-content:center;margin-top:14px">Retomar</a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    (function(){
      // Data de hoje
      var d = new Date();
      var fmt = d.toLocaleDateString('pt-BR', { weekday:'long', day:'numeric', month:'long' });
      var el = document.getElementById('hoje'); if(el) el.textContent = fmt;

      // Streak diário (mesma convenção do curso: de_streak / de_last_visit)
      function ler(k,def){ try{ var v=localStorage.getItem(k); return v===null?def:v; }catch(e){ return def; } }
      function grav(k,v){ try{ localStorage.setItem(k,v); }catch(e){} }
      var hoje = new Date().toISOString().slice(0,10);
      var last = ler('de_last_visit','');
      var streak = parseInt(ler('de_streak','0'),10)||0;
      if(last !== hoje){
        if(last){ var diff = Math.round((new Date(hoje)-new Date(last))/86400000); streak = diff===1 ? streak+1 : 1; }
        else { streak = 1; }
        grav('de_streak', String(streak)); grav('de_last_visit', hoje);
      }
      var s = document.getElementById('stat-streak'); if(s) s.textContent = streak;

      // North Star: 16 - concluídos
      var done = []; try{ done = JSON.parse(ler('de_modulos_concluidos','[]')); }catch(e){}
      var falta = 16 - (Array.isArray(done)?done.length:0);
      var n = document.getElementById('stat-north'); if(n) n.textContent = falta;
      var pct = Math.round(((Array.isArray(done)?done.length:0)/16)*100);
      var p = document.getElementById('stat-pct'); if(p && pct>0) p.textContent = pct + '%';
    })();
  </script>
</Base>
