---
import Base from '../layouts/Base.astro';
---
<Base title="Diário de aprendizado — Engenharia de Dados" active="diario">
  <main class="wrap" style="padding-top:32px;padding-bottom:48px;max-width:820px">

    <h1 style="font-size:28px">Diário de aprendizado</h1>
    <p class="muted" style="font-size:16px;margin:8px 0 0">Metacognição faz parte do método. Escreva 3 linhas por sessão — ajuda a reter e vira matéria-prima para falar dos seus projetos em entrevistas.</p>

    <div style="display:flex;gap:12px;align-items:flex-start;background:var(--gold-bg);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin:18px 0">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
      <p style="margin:0;font-size:13.5px">As anotações ficam salvas <strong>no seu navegador</strong>. Para versionar de verdade (build-in-public), use <strong>Copiar tudo</strong> e cole no arquivo <code>diario.md</code> do repositório.</p>
    </div>

    <!-- Form -->
    <form class="card" id="form" style="padding:20px;display:flex;flex-direction:column;gap:14px">
      <div>
        <label class="lbl" for="f1">O que estudei / construí hoje?</label>
        <textarea id="f1" rows="2" style="width:100%;margin-top:6px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--ink);font-family:var(--man);font-size:15px;resize:vertical"></textarea>
      </div>
      <div>
        <label class="lbl" for="f2">O que eu ensinaria disso? (teste de Feynman)</label>
        <textarea id="f2" rows="2" style="width:100%;margin-top:6px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--ink);font-family:var(--man);font-size:15px;resize:vertical"></textarea>
      </div>
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:14px">
        <div>
          <label class="lbl" for="f3">Onde travei / dúvida</label>
          <textarea id="f3" rows="2" style="width:100%;margin-top:6px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--ink);font-family:var(--man);font-size:15px;resize:vertical"></textarea>
        </div>
        <div>
          <label class="lbl" for="f4">Próximo passo</label>
          <textarea id="f4" rows="2" style="width:100%;margin-top:6px;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--ink);font-family:var(--man);font-size:15px;resize:vertical"></textarea>
        </div>
      </div>
      <div style="display:flex;gap:10px">
        <button type="submit" class="btn btn-p">Salvar entrada</button>
        <button type="button" id="copiar" class="btn btn-s">Copiar tudo</button>
      </div>
    </form>

    <div style="display:flex;justify-content:space-between;align-items:baseline;margin:28px 0 10px">
      <h2 style="font-size:20px">Entradas</h2>
      <span class="muted" id="contador" style="font-size:14px"></span>
    </div>
    <div id="lista" style="display:flex;flex-direction:column;gap:14px"></div>

  </main>

  <script is:inline>
    (function(){
      var KEY='de_diario';
      function ler(){ try{ return JSON.parse(localStorage.getItem(KEY)||'[]'); }catch(e){ return []; } }
      function grav(a){ try{ localStorage.setItem(KEY, JSON.stringify(a)); }catch(e){} }
      function esc(s){ return (s||'').replace(/[&<>]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); }

      function render(){
        var arr = ler();
        var lista = document.getElementById('lista');
        var cont = document.getElementById('contador');
        cont.textContent = arr.length + (arr.length===1?' entrada':' entradas');
        if(!arr.length){ lista.innerHTML = '<div class="muted" style="font-size:14px">Nenhuma entrada ainda — registre sua primeira sessão acima.</div>'; return; }
        lista.innerHTML = arr.map(function(e,i){
          var linhas = [
            e.f1 ? '<div style="margin:6px 0 0"><strong>Estudei:</strong> '+esc(e.f1)+'</div>' : '',
            e.f2 ? '<div style="margin:6px 0 0"><strong>Ensinaria:</strong> '+esc(e.f2)+'</div>' : '',
            e.f3 ? '<div style="margin:6px 0 0"><strong>Travei:</strong> '+esc(e.f3)+'</div>' : '',
            e.f4 ? '<div style="margin:6px 0 0"><strong>Próximo:</strong> '+esc(e.f4)+'</div>' : ''
          ].join('');
          return '<div class="card" style="padding:16px 18px">'
            + '<div style="display:flex;justify-content:space-between;align-items:center">'
            + '<span style="font-family:var(--sora);font-weight:600">'+esc(e.data)+'</span>'
            + '<button data-i="'+i+'" class="del" style="background:none;border:0;color:var(--muted);cursor:pointer;font-size:13px">remover</button></div>'
            + '<div style="font-size:14px;line-height:1.5">'+linhas+'</div></div>';
        }).join('');
        Array.prototype.forEach.call(lista.querySelectorAll('.del'), function(b){
          b.addEventListener('click', function(){ var a=ler(); a.splice(+b.getAttribute('data-i'),1); grav(a); render(); });
        });
      }

      document.getElementById('form').addEventListener('submit', function(ev){
        ev.preventDefault();
        var f = function(id){ return document.getElementById(id).value.trim(); };
        if(!f('f1') && !f('f2') && !f('f3') && !f('f4')) return;
        var data = new Date().toISOString().slice(0,10);
        var arr = ler(); arr.unshift({ data:data, f1:f('f1'), f2:f('f2'), f3:f('f3'), f4:f('f4') }); grav(arr);
        ['f1','f2','f3','f4'].forEach(function(id){ document.getElementById(id).value=''; });
        render();
      });

      document.getElementById('copiar').addEventListener('click', function(){
        var arr = ler();
        var txt = arr.map(function(e){
          return '### '+e.data+'\n- Estudei/construí: '+(e.f1||'')+'\n- Ensinaria assim: '+(e.f2||'')+'\n- Travei em / dúvida: '+(e.f3||'')+'\n- Próximo passo: '+(e.f4||'');
        }).join('\n\n');
        try{ navigator.clipboard.writeText(txt); this.textContent='Copiado!'; var b=this; setTimeout(function(){ b.textContent='Copiar tudo'; },1500); }catch(e){ alert(txt); }
      });

      render();
    })();
  </script>
</Base>
