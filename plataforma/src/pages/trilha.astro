---
import Base from '../layouts/Base.astro';
import curso from '../data/curso.json';

const totalMods = curso.eixos.reduce((n, e) => n + e.modulos.length, 0);
---
<Base title="Trilha — Engenharia de Dados" active="home">
  <main class="wrap" style="padding-top:32px;padding-bottom:48px">
    <h1 style="font-size:30px">Trilha da Especialização</h1>
    <p class="muted" style="font-size:16px;margin:8px 0 0">{totalMods} disciplinas · {curso.eixos.length} eixos — avance por maestria, um módulo por vez.</p>

    <div style="margin-top:24px;display:flex;flex-direction:column;gap:26px">
      {curso.eixos.map((eixo) => (
        <section>
          <div style="font-family:var(--sora);font-weight:600;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px">Eixo {eixo.id} — {eixo.nome}</div>
          <div style="display:flex;flex-direction:column;gap:10px">
            {eixo.modulos.map((mod) => {
              const temTeoria = mod.unidades.some((u) => u.tipo === 'teoria');
              return (
                <a href={`/modulo/${mod.pasta}`} class="card" style="padding:14px 18px;display:flex;justify-content:space-between;align-items:center;color:var(--ink)">
                  <div>
                    <div style="font-family:var(--sora);font-weight:600;font-size:16px">{mod.id} · {mod.nome}</div>
                    <div class="muted" style="font-size:13px">{mod.ch}h · {mod.unidades.length} unidades</div>
                  </div>
                  <span class="pill" style={temTeoria ? '' : 'background:var(--border);color:var(--muted)'}>{temTeoria ? 'Disponível' : 'Em breve'}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
</Base>
