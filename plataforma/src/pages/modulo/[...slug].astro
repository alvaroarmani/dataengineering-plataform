---
import Base from '../../layouts/Base.astro';
import curso from '../../data/curso.json';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const paths = [];
  for (const eixo of curso.eixos) {
    for (const mod of eixo.modulos) {
      paths.push({ params: { slug: mod.pasta }, props: { mod, eixo } });
    }
  }
  return paths;
}

const { mod, eixo } = Astro.props;

const iconeTipo = {
  teoria: 'M4 19V5a1 1 0 0 1 1-1h11l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z',
  lab: 'M4 4h16v12H4zM8 20h8M12 16v4',
  exercicio: 'M7 4l12 8-12 8z',
  flashcards: 'M6 4h12v16l-6-3-6 3z',
  recursos: 'M4 5h16M4 12h16M4 19h10',
  index: 'M4 5h16M4 12h16M4 19h10',
};
const rotulo = { teoria: 'Teoria', lab: 'Lab', exercicio: 'Exercício', flashcards: 'Flashcards', recursos: 'Recursos' };

// index.md vira slug = pasta (o Astro remove o "/index")
const indexEntry = await getEntry('aulas', mod.pasta);
const primeira = mod.unidades.find((u) => u.tipo !== 'index');
let Content = null;
if (indexEntry) { Content = (await indexEntry.render()).Content; }
---
<Base title={`${mod.id} — ${mod.nome}`} active="home">
  <main class="wrap" style="padding-top:28px;padding-bottom:48px">

    <div style="font-size:13px" class="muted"><a href="/trilha" style="color:var(--muted)">Trilha</a> / Eixo {eixo.id} — {eixo.nome}</div>
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin:10px 0 24px;flex-wrap:wrap">
      <div>
        <h1 style="font-size:30px;max-width:640px">{mod.id} — {mod.nome}</h1>
        <div class="muted" style="font-size:14px;margin-top:8px">{mod.ch} horas · {mod.unidades.length} unidades</div>
      </div>
      {primeira && <a class="btn btn-p" href={`/aula/${mod.pasta}/${primeira.base}`}>Começar módulo
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></a>}
    </div>

    <div class="grid" style="grid-template-columns:1fr 320px;gap:28px;align-items:start">
      <!-- Conteúdo do índice do módulo -->
      <div class="prosa">
        {Content ? <Content /> : <p class="muted">Ementa em preparação.</p>}
      </div>

      <!-- Syllabus -->
      <aside class="card" style="padding:8px 8px;position:sticky;top:90px">
        <div class="lbl" style="padding:12px 12px 6px">Conteúdo do módulo</div>
        <div style="display:flex;flex-direction:column">
          {mod.unidades.filter((u) => u.tipo !== 'index').map((u) => (
            <a href={`/aula/${mod.pasta}/${u.base}`} style="display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:10px;color:var(--ink)">
              <span style="width:28px;height:28px;border-radius:8px;background:var(--green-t);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--green-d)" stroke-width="2"><path d={iconeTipo[u.tipo] || iconeTipo.recursos}/></svg>
              </span>
              <span style="min-width:0">
                <span style="display:block;font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{u.titulo}</span>
                <span class="muted" style="font-size:12px">{rotulo[u.tipo] || u.tipo}</span>
              </span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </main>
</Base>
