---
const { title = 'Especialização em Engenharia de Dados', active = '' } = Astro.props;
import '../styles/global.css';
import Nav from '../components/Nav.astro';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" />
  <!-- Aplica o tema salvo antes de pintar (evita flash) -->
  <script is:inline>
    (function(){ try{ var t = localStorage.getItem('tema'); if(t) document.documentElement.setAttribute('data-theme', t); }catch(e){} })();
  </script>
</head>
<body>
  <Nav active={active} />
  <slot />
  <script is:inline>
    window.alternarTema = function(){
      var el = document.documentElement;
      var atual = el.getAttribute('data-theme');
      var novo = atual === 'dark' ? 'light' : 'dark';
      // se não havia atributo, decide a partir do sistema
      if(!atual){ novo = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'light' : 'dark'; }
      el.setAttribute('data-theme', novo);
      try{ localStorage.setItem('tema', novo); }catch(e){}
    };
  </script>
</body>
</html>
